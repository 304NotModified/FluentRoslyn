<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <PackageId>FluentRoslyn</PackageId>
    <Version>0.1.0</Version>
    <Authors>Julian Verdurmen</Authors>
    <Description>A familiar reflection-like API for writing Roslyn analyzers and source generators.</Description>
    <PackageTags>roslyn;analyzer;source-generator;reflection;fluent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/304NotModified/FluentRoslyn</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

</Project>
